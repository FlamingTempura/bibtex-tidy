{
	"name": "bibtex-tidy",
	"version": "1.14.0",
	"description": "Tidy bibtex files",
	"homepage": "https://github.com/FlamingTempura/bibtex-tidy",
	"repository": {
		"type": "git",
		"url": "https://github.com/FlamingTempura/bibtex-tidy.git"
	},
	"author": "FlamingTempura",
	"license": "MIT",
	"main": "./bibtex-tidy.js",
	"type": "module",
	"module": "./bibtex-tidy.js",
	"types": "./bibtex-tidy.d.ts",
	"man": "./bibtex-tidy.0",
	"bin": {
		"bibtex-tidy": "./bin/bibtex-tidy"
	},
	"files": [
		"bin/bibtex-tidy",
		"bibtex-tidy.js",
		"bibtex-tidy.d.ts",
		"bibtex-tidy.0"
	],
	"scripts": {
		"build": "node build.ts",
		"serve": "node build.ts --serve",
		"test": "vitest run --globals",
		"test:unit": "npm run test -- src",
		"test:update-snapshots": "UPDATE_VISUAL_SNAPSHOTS=1 npm test -- test/ui/ui-vr.test.ts",
		"typecheck": "tsc --noEmit",
		"cover": "vitest run --globals --coverage --coverage.reporter=text --coverage.reporter=lcov src",
		"preversion": "git pull --rebase",
		"version": "./scripts/prepare-release.sh",
		"postversion": "git push --follow-tags && npm publish",
		"codemirror-grammar": "lezer-generator src/ui/codemirrorExtensions/bibtex.grammar -o src/ui/codemirrorExtensions/__generated__/bibtex.ts",
		"check": "npx @biomejs/biome check"
	},
	"engines": {
		"node": ">12"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@codemirror/commands": "^6.6.1",
		"@codemirror/language": "^6.11.1",
		"@codemirror/lint": "^6.8.1",
		"@codemirror/view": "^6.37.1",
		"@lezer/generator": "^1.7.3",
		"@lezer/highlight": "^1.2.1",
		"@tsconfig/svelte": "^5.0.4",
		"@types/node": "^25.9.1",
		"@vitest/coverage-v8": "^4.1.7",
		"core-js": "^3.43.0",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.3",
		"playwright": "^1.60.0",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7",
		"yaml": "^2.8.0"
	}
}
