{
	"files": {
		"includes": [
			"**/*.{ts,json,svelte,html}",
			"!**/__generated__",
			"!bibtex-tidy.d.ts",
			"!src/ui/codemirrorExtensions/bibtex.terms.ts"
		]
	},
	"linter": {
		"rules": {
			"correctness": {
				"useImportExtensions": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					}
				}
			}
		}
	]
}
