{
	"files": {
		"includes": [
			"**/src/**/*",
			"**/test/**/*",
			"**/build.ts",
			"**/package.json",
			"**/tsconfig.json",
			"**/biome.json",
			"!**/__generated__",
			"!**/src/ui/codemirrorExtensions/bibtex.terms.ts"
		]
	},
	"linter": {
		"rules": {
			"correctness": {
				"useImportExtensions": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					}
				}
			}
		}
	]
}
